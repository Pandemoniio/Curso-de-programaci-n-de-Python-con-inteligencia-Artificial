{
  "folders": [
    {
      "name": "Plataforma Educativa (Raiz)",
      "path": "."
    },
    {
      "name": "Frontend & Estilos",
      "path": "./assets"
    },
    {
      "name": "Backend & API Server",
      "path": "./backend"
    },
    {
      "name": "Base de Datos & SQL",
      "path": "./database"
    },
    {
      "name": "Proyectos y Clases Python",
      "path": "./proyectos_python"
    },
    {
      "name": "Documentacion & Guias",
      "path": "./docs"
    }
  ],
  "settings": {
    "files.encoding": "utf8",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "python.analysis.autoImportCompletions": true,
    "python.terminal.activateEnvironment": true,
    "files.exclude": {
      "**/__pycache__": true,
      "**/.git": false
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "ritwickdey.liveserver",
      "esbenp.prettier-vscode"
    ]
  }
}
